					max = 20;
					min = 20;
				}
				[all*]
				{
					il_main = #spell/50-100;
					max = 20;
					min = 20;
				}
			}
			[misc]
			{
////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////
			       	[all*]
				{
					il_main = #ring/-rare(1)/10-25;
					max = 10;
					min = 5;
				}
			     	[all*]
				{
					il_main = #ring/-unique(2)/22-35;
					max = 10;
					min = 5;
				}
//------------------------------------------------------------------------------
				[all*]
				{
					il_main = #amulet/-rare(1)/15-50;
					max = 10;
					min = 5;
				}
				[all*]
				{
					il_main = #amulet/-unique(2)/20-25;
					max = 10;
					min = 5;
				}
////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////
				[all*]
				{
					il_main = DSX_backpack_empty;
					max = 3;
					min = 2;
				}
				[all*]
				{
					il_main = #spellbook/16-21;
					max = 4;
					min = 4;
				}
				[all*]
				{
					il_main = #spellbook/22-25;
					max = 12;
					min = 9;
				}
				[all*]
				{
					il_main = #spellbook/26-35;
					max = 4;
					min = 4;
				}
				[all*]
				{
					il_main = book_glb_magic_01;
					max = 10;
					min = 1;
				}
				[all*]
				{
					il_main = #ring/-mod(1)/22-25;
					max = 3;
					min = 1;
				}
				[all*]
				{
					il_main = #amulet/-mod(1)/22-25;
					max = 3;
					min = 1;
				}
			}
		}
	}
	[respawn_shrine]
	{
	}
	[store]
	{
		item_markup = 2;
		[item_restock]
		{
			potion_health_small = 12;
			potion_mana_small = 12;

			potion_health_medium = 17;
			potion_mana_medium = 17;

			potion_rejuvenation_small = 5;
			potion_rejuvenation_medium = 2;
			
			scroll_resurrect = 2;
			spell_resurrect = 2;
			spell_revive = 2;
			spell_healing_hands = 1;
			spell_healing_wind = 1;
			spell_fireshot = 1;
			spell_zap = 1;
		}
	}
	[mind]
	{
		jat_talk = world\ai\jobs\actors\good\job_talk_laeta.skrit;
	}	
}


