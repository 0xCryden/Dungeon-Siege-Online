// UTRAEAN ALCHEMIST
[t:template,n:dsx_laeta]
{
	category_name = "1W_shopkeep";
	doc = "DSX Laeta";
	specializes = dsx_base_npc_fg;
	[actor]
	{
		portrait_icon = b_gui_ig_i_ic_c_laeta;
	}
	[aspect]
	{
		draw_selection_indicator = TRUE;
		use_range = 1.0;
		is_ghost_usable = TRUE;
		[textures]
		{
			0 = b_c_gan_utraean_skin_04;
			1 = b_c_pos_a7_017;
		}
		model = m_c_gah_fg_pos_a7;
	}
	[common]
	{
		screen_name = "Laeta";
	}
	[conversation]
	{
	}
	[inventory]
	{
		custom_head = m_c_gah_fg_hlmt_head-02;
		[equipment]
		{
			es_feet = bo_bo_le_light;
		}
		[store_pcontent]
		{
			full_ratio = 0;
			
			[magic]
			{
				[all*]
				{
					il_main = #spell/0-3;
