[t:template,n:dsx_blacksmith_base] //maybe there should be a dsx_base_blacksmith?
{
	specializes = base_npc_bs;
	category_name = "1W_shopkeep";
	doc = "DSX Blacksmith BASE";
 common:screen_name = "Blacksmith BASE";
	
	[aspect]
		{
			use_range = 1.0;
			is_ghost_usable = TRUE;
			model = m_c_gbn_bs_BS2;
			[textures] { 0=b_c_gbn_bs-03; }
		}

	[actor]	{portrait_icon = b_gui_ig_i_ic_c_blacksmith;}

	[respawn_shrine]
		{
		}
	[store]
		{
			item_markup = 2;
		}
}

