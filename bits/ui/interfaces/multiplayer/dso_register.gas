[dso_register]
{
	interface = true;

	skrit = [[

		owner = UIWindow;
		
		#include "k_inc_ui"
		#include "k_inc_rs_packet"

		begin$()
		{
			UIShell.HideInterface( "dso_login" );
			UIShell.DeactivateInterface( "dso_login" );
		}

		poll$()
		{
			bool transition$ = false;
			
			if (NetworkManager.IsConnected())
			{
				int received$ = NetworkManager.Receive();
				if (received$ > 0)
				{
					Packet packet$ = NetworkManager.NextPacket();
					
					int type$ = packet$.ReadUInt8();
					if (type$ == 37)
					{
						int success$ = packet$.ReadUInt8();
						if (success$ == 1)
						{
							SetUIWindowState$ ("register_ok", "dso_register", true, true);
							SetUIWindowState$ ("account_name_edit_box", "dso_register", true, true);
							SetUIWindowState$ ("password_edit_box", "dso_register", true, true);
							SetUIWindowState$ ("password__confirm_edit_box", "dso_register", true, true);
							
							DisplayMessage$ ("Username already in use");
						}
						else if (success$ == 2)
						{
							SetUIWindowState$ ("register_ok", "dso_register", true, true);
							SetUIWindowState$ ("account_name_edit_box", "dso_register", true, true);
							SetUIWindowState$ ("password_edit_box", "dso_register", true, true);
							SetUIWindowState$ ("password_confirm_edit_box", "dso_register", true, true);
							
							DisplayMessage$ ("Invalid characters used in username or password");
						}
						else
						{
							SetUIWindowState$ ("register_ok", "dso_register", true, true);
							SetUIWindowState$ ("account_name_edit_box", "dso_register", true, true);
							SetUIWindowState$ ("password_edit_box", "dso_register", true, true);
							SetUIWindowState$ ("password_confirm_edit_box", "dso_register", true, true);

							string username$; QueryDerivedEditBox (UIShell.FindUIWindow ("account_name_edit_box", "dso_register")).GetText(username$);

							string message$; StringTool.AssignF(message$, "Account %s created successfully", username$);
							DisplayMessage$ (message$);
							//transition$ = true;
						}
					}
					
					NetworkManager.DiscardPacket (packet$);
				}
			}
			
			if (transition$ == true)
			{
				string username$; QueryDerivedEditBox (UIShell.FindUIWindow ("account_name_edit_box", "dso_register")).GetText(username$);
				string rnd$ = username$;
				QueryDerivedEditBox (UIShell.FindUIWindow ("staging_char_name_edit_box", "dso_register")).SetText (rnd$);
				
				Player player$ = Server.LocalHumanPlayer;
				
				// Cryden TODO add new UI screen after this, dont staging start game
				Messenger.Notify ("staging_create_character_ok", owner);
				Messenger.Notify ("staging_start_game", owner);
				
				if (player$ != NULL)
				{
					player$.RSSetHeroCloneSourceTemplate ("portal");
					// RSSetHeroHead
					player$.RSSetHeroSkin (MakePlayerSkin (0), "b_c_gah_fg_skin_002,b_c_gah_fg_hair_001");
					player$.RSSetHeroSkin (MakePlayerSkin (1), "b_c_pos_a1_pant_006,b_c_pos_a1_shrt_009");
					report.screen ("SET SUCCESSFULLY!");
					
					UICharacterSelect.RSGeneratePortrait (player$.Id);
				}
			}
			else
			{
				// keep polling
				UIWindow window$ = UIShell.FindUIWindow ("timer02", "dso_register");
				window$.ProcessAction (action_alphaanimation, "1,0,0");
			}
		}
		
		register$()
		{
			UIWindow blocked$ = UIShell.FindUIWindow ("register_ok", "dso_register");
			if (blocked$.IsEnabled != true)
			{
				return;
			}
			
			string username$; QueryDerivedEditBox (UIShell.FindUIWindow ("account_name_edit_box", "dso_register")).GetText(username$);
			string password$; QueryDerivedEditBox (UIShell.FindUIWindow ("password_edit_box", "dso_register")).GetText(password$);
			string passwordConfirm$; QueryDerivedEditBox (UIShell.FindUIWindow ("password_confirm_edit_box", "dso_register")).GetText(passwordConfirm$);
			
			if (password$ != passwordConfirm$)
			{
				DisplayMessage$ ("Passwords mismatch. Make sure both passwords are the same");
				return;
			}

			if (StringTool.IsEmpty (username$) || StringTool.IsEmpty (password$))
			{
				DisplayMessage$ ("Please enter a username and password");
				return;
			}
			
			SetUIWindowState$ ("register_ok", "dso_register", true, false);
			SetUIWindowState$ ("account_name_edit_box", "dso_register", true, false);
			SetUIWindowState$ ("password_edit_box", "dso_register", true, false);
			SetUIWindowState$ ("password_confirm_edit_box", "dso_register", true, false);
			
			RSRegister$ (username$, password$);
		}
		
		backtologin$()
		{
			UIWindow blocked$ = UIShell.FindUIWindow ("back_to_login_ok", "dso_register");
			if (blocked$.IsEnabled != true)
			{
				return;
			}
			SetUIWindowState$ ("back_to_login_ok", "dso_register", true, false);
			SetUIWindowState$ ("account_name_edit_box", "dso_register", true, false);
			SetUIWindowState$ ("password_edit_box", "dso_register", true, false);
			SetUIWindowState$ ("password_confirm_edit_box", "dso_register", true, false);
			
			UIShell.ActivateInterface( "ui:interfaces:multiplayer:dso_login", true);
		}

		onescape$()
		{
			if (NetworkManager.IsConnected())
			{
				NetworkManager.Disconnect();
			}
			
			Messenger.Notify ("staging_create_character_cancel", owner);
		}
	]];
	
	[t:window,n:timer01]
	{
		[messages]
		{
			onshow = alphaanimation(0.01,0.0,0.0);
			onanimcomplete = call (begin$);
		}
	}
	[t:window,n:timer02]
	{
		[messages]
		{
			onshow = alphaanimation(0.05,0.0,0.0);
			onanimcomplete = call (poll$);
		}
	}
	
