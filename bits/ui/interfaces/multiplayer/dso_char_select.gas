		selectChar$()
		{
			string selectSlot$;
			UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( "selected", "dso_char_select" ) );
			uiText$.GetText( selectSlot$);

			int selectedSlot$ = 0;
			if (selectSlot$ == "1")
			{
				selectedSlot$ = 1;
			}
			else if (selectSlot$ == "2")
			{
				selectedSlot$ = 2;
			}
			else if (selectSlot$ == "3")
			{
				selectedSlot$ = 3;
			}
			else if (selectSlot$ == "4")
			{
				selectedSlot$ = 4;
			}

			RSEnterGame$(selectedSlot$);
		}

		deleteChar$()
		{
			string selectSlot$;
			UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( "selected", "dso_char_select" ) );
			uiText$.GetText( selectSlot$);

			int selectedSlot$ = 0;
			if (selectSlot$ == "1")
			{
				selectedSlot$ = 1;
			}
			else if (selectSlot$ == "2")
			{
				selectedSlot$ = 2;
			}
			else if (selectSlot$ == "3")
			{
				selectedSlot$ = 3;
			}
			else if (selectSlot$ == "4")
			{
				selectedSlot$ = 4;
			}

			RSDeleteChar$(selectedSlot$);
		}

		createChar$()
		{
			UIShell.ActivateInterface( "ui:interfaces:multiplayer:dso_char_create", true);
		}

		logout$()
		{
			UIShell.ActivateInterface( "ui:interfaces:multiplayer:dso_login", true);
		}

		poll$()
		{
			bool transition$ = false;
			
			if (NetworkManager.IsConnected())
			{
				int received$ = NetworkManager.Receive();
				if (received$ > 0)
				{
					Packet packet$ = NetworkManager.NextPacket();
					
					int type$ = packet$.ReadUInt8();
					if (type$ == 38)
					{
						int success$ = packet$.ReadUInt8();
						if (success$ == 1)
						{
							DisplayMessage$ ("Incorrent username or password");
						}
						else if (success$ == 2)
						{
							DisplayMessage$ ("Invalid characters used");
						}
						else
						{
							int charsAmount$ = packet$.ReadUInt8();
							if (charsAmount$ == 0)
							{
								UIShell.FindUIWindow ("staging_character_ok", "dso_char_select").ProcessAction(action_setvisible, "false");
								UIShell.FindUIWindow ("staging_character_delete", "dso_char_select").ProcessAction(action_setvisible, "false");
							}
							if (charsAmount$ > 0)
							{
								select1$();

								UIShell.FindUIWindow ("character1_bg", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character1_icon_melee", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character1_icon_ranged", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character1_icon_nmagic", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character1_icon_cmagic", "dso_char_select").ProcessAction(action_setvisible, "true");
								
								UIShell.FindUIWindow ("character1_name", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character1_class", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character1_skills", "dso_char_select").ProcessAction(action_setvisible, "true");

								UIShell.FindUIWindow ("character1_melee", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character1_ranged", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character1_nmagic", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character1_cmagic", "dso_char_select").ProcessAction(action_setvisible, "true");

								string charName$ = packet$.ReadString();
								UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( "character1_name", "dso_char_select" ) );
								uiText$.SetText( charName$, true );

								string charTitle$ = packet$.ReadString();
								UIText uiText2$ = QueryDerivedText( UIShell.FindUIWindow( "character1_class", "dso_char_select" ) );
								uiText2$.SetText( charTitle$, true );

								string charStats$ = packet$.ReadString();
								UIText uiText3$ = QueryDerivedText( UIShell.FindUIWindow( "character1_skills", "dso_char_select" ) );
								uiText3$.SetText( charStats$, true );

								string charMelee$ = packet$.ReadString();
								UIText uiText4$ = QueryDerivedText( UIShell.FindUIWindow( "character1_melee", "dso_char_select" ) );
								uiText4$.SetText( charMelee$, true );

								string charRanged$ = packet$.ReadString();
								UIText uiText5$ = QueryDerivedText( UIShell.FindUIWindow( "character1_ranged", "dso_char_select" ) );
								uiText5$.SetText( charRanged$, true );

								string charNmagic$ = packet$.ReadString();
								UIText uiText6$ = QueryDerivedText( UIShell.FindUIWindow( "character1_nmagic", "dso_char_select" ) );
								uiText6$.SetText( charNmagic$, true );

								string charCmagic$ = packet$.ReadString();
								UIText uiText7$ = QueryDerivedText( UIShell.FindUIWindow( "character1_cmagic", "dso_char_select" ) );
								uiText7$.SetText( charCmagic$, true );
							}
							if (charsAmount$ > 1)
							{
								UIShell.FindUIWindow ("character2_bg", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character2_icon_melee", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character2_icon_ranged", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character2_icon_nmagic", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character2_icon_cmagic", "dso_char_select").ProcessAction(action_setvisible, "true");

								UIShell.FindUIWindow ("character2_name", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character2_class", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character2_skills", "dso_char_select").ProcessAction(action_setvisible, "true");

								UIShell.FindUIWindow ("character2_melee", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character2_ranged", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character2_nmagic", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character2_cmagic", "dso_char_select").ProcessAction(action_setvisible, "true");

								string charName$ = packet$.ReadString();
								UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( "character2_name", "dso_char_select" ) );
								uiText$.SetText( charName$, true );

								string charTitle$ = packet$.ReadString();
								UIText uiText2$ = QueryDerivedText( UIShell.FindUIWindow( "character2_class", "dso_char_select" ) );
								uiText2$.SetText( charTitle$, true );

								string charStats$ = packet$.ReadString();
								UIText uiText3$ = QueryDerivedText( UIShell.FindUIWindow( "character2_skills", "dso_char_select" ) );
								uiText3$.SetText( charStats$, true );

								string charMelee$ = packet$.ReadString();
								UIText uiText4$ = QueryDerivedText( UIShell.FindUIWindow( "character2_melee", "dso_char_select" ) );
								uiText4$.SetText( charMelee$, true );

								string charRanged$ = packet$.ReadString();
								UIText uiText5$ = QueryDerivedText( UIShell.FindUIWindow( "character2_ranged", "dso_char_select" ) );
