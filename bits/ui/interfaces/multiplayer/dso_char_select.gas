								UIText uiText7$ = QueryDerivedText( UIShell.FindUIWindow( "character2_cmagic", "dso_char_select" ) );
								uiText7$.SetText( charCmagic$, true );
							}
							if (charsAmount$ > 2)
							{
								UIShell.FindUIWindow ("character3_bg", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character3_icon_melee", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character3_icon_ranged", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character3_icon_nmagic", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character3_icon_cmagic", "dso_char_select").ProcessAction(action_setvisible, "true");

								UIShell.FindUIWindow ("character3_name", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character3_class", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character3_skills", "dso_char_select").ProcessAction(action_setvisible, "true");

								UIShell.FindUIWindow ("character3_melee", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character3_ranged", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character3_nmagic", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character3_cmagic", "dso_char_select").ProcessAction(action_setvisible, "true");

								string charName$ = packet$.ReadString();
								UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( "character3_name", "dso_char_select" ) );
								uiText$.SetText( charName$, true );

								string charTitle$ = packet$.ReadString();
								UIText uiText2$ = QueryDerivedText( UIShell.FindUIWindow( "character3_class", "dso_char_select" ) );
								uiText2$.SetText( charTitle$, true );

								string charStats$ = packet$.ReadString();
								UIText uiText3$ = QueryDerivedText( UIShell.FindUIWindow( "character3_skills", "dso_char_select" ) );
								uiText3$.SetText( charStats$, true );

								string charMelee$ = packet$.ReadString();
								UIText uiText4$ = QueryDerivedText( UIShell.FindUIWindow( "character3_melee", "dso_char_select" ) );
								uiText4$.SetText( charMelee$, true );

								string charRanged$ = packet$.ReadString();
								UIText uiText5$ = QueryDerivedText( UIShell.FindUIWindow( "character3_ranged", "dso_char_select" ) );
								uiText5$.SetText( charRanged$, true );

								string charNmagic$ = packet$.ReadString();
								UIText uiText6$ = QueryDerivedText( UIShell.FindUIWindow( "character3_nmagic", "dso_char_select" ) );
								uiText6$.SetText( charNmagic$, true );

								string charCmagic$ = packet$.ReadString();
								UIText uiText7$ = QueryDerivedText( UIShell.FindUIWindow( "character3_cmagic", "dso_char_select" ) );
								uiText7$.SetText( charCmagic$, true );
							}
							if (charsAmount$ > 3)
							{
								UIShell.FindUIWindow ("character4_bg", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character4_icon_melee", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character4_icon_ranged", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character4_icon_nmagic", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character4_icon_cmagic", "dso_char_select").ProcessAction(action_setvisible, "true");

								UIShell.FindUIWindow ("character4_name", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character4_class", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character4_skills", "dso_char_select").ProcessAction(action_setvisible, "true");

								UIShell.FindUIWindow ("character4_melee", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character4_ranged", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character4_nmagic", "dso_char_select").ProcessAction(action_setvisible, "true");
								UIShell.FindUIWindow ("character4_cmagic", "dso_char_select").ProcessAction(action_setvisible, "true");

								string charName$ = packet$.ReadString();
								UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( "character4_name", "dso_char_select" ) );
								uiText$.SetText( charName$, true );

								string charTitle$ = packet$.ReadString();
								UIText uiText2$ = QueryDerivedText( UIShell.FindUIWindow( "character4_class", "dso_char_select" ) );
								uiText2$.SetText( charTitle$, true );

								string charStats$ = packet$.ReadString();
								UIText uiText3$ = QueryDerivedText( UIShell.FindUIWindow( "character4_skills", "dso_char_select" ) );
								uiText3$.SetText( charStats$, true );

								string charMelee$ = packet$.ReadString();
								UIText uiText4$ = QueryDerivedText( UIShell.FindUIWindow( "character4_melee", "dso_char_select" ) );
								uiText4$.SetText( charMelee$, true );

								string charRanged$ = packet$.ReadString();
								UIText uiText5$ = QueryDerivedText( UIShell.FindUIWindow( "character4_ranged", "dso_char_select" ) );
								uiText5$.SetText( charRanged$, true );

								string charNmagic$ = packet$.ReadString();
								UIText uiText6$ = QueryDerivedText( UIShell.FindUIWindow( "character4_nmagic", "dso_char_select" ) );
								uiText6$.SetText( charNmagic$, true );

								string charCmagic$ = packet$.ReadString();
								UIText uiText7$ = QueryDerivedText( UIShell.FindUIWindow( "character4_cmagic", "dso_char_select" ) );
								uiText7$.SetText( charCmagic$, true );


								SetUIWindowState$ ("staging_character_create", "dso_char_select", true, false);
							}
						}
					}
					if (type$ == 39)
					{
						int success$ = packet$.ReadUInt8();
						if (success$ == 1)
						{
							DisplayMessage$ ("Account has no characters");
						}
						else if (success$ == 2)
						{
							DisplayMessage$ ("Character already in use");
						}
						else
						{
							transition$ = true;
						}
					}
					if (type$ == 41)
					{
						int success$ = packet$.ReadUInt8();
						begin$();
					}
					NetworkManager.DiscardPacket (packet$);
				}
			}
			
			if (transition$ == true)
			{
				string name$;

				string selectSlot$;
				UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( "selected", "dso_char_select" ) );
				uiText$.GetText( selectSlot$);

				if (selectSlot$ == "1")
				{
					QueryDerivedText (UIShell.FindUIWindow ("character1_name", "dso_char_select")).GetText(name$);
				}
				else if (selectSlot$ == "2")
				{
					QueryDerivedText (UIShell.FindUIWindow ("character2_name", "dso_char_select")).GetText(name$);
				}
				else if (selectSlot$ == "3")
				{
					QueryDerivedText (UIShell.FindUIWindow ("character3_name", "dso_char_select")).GetText(name$);
				}
				else if (selectSlot$ == "4")
				{
					QueryDerivedText (UIShell.FindUIWindow ("character4_name", "dso_char_select")).GetText(name$);
				}
				
				QueryDerivedEditBox (UIShell.FindUIWindow ("staging_char_name_edit_box", "dso_char_select")).SetText (name$);
				
				Player player$ = Server.LocalHumanPlayer;
				
				// Cryden TODO add new UI screen after this, dont staging start game
				Messenger.Notify ("staging_create_character_ok", owner);
				Messenger.Notify ("staging_start_game", owner);
				
				if (player$ != NULL)
				{
					player$.RSSetHeroCloneSourceTemplate ("portal");
					// RSSetHeroHead
					player$.RSSetHeroSkin (MakePlayerSkin (0), "b_c_gah_fg_skin_002,b_c_gah_fg_hair_001");
					player$.RSSetHeroSkin (MakePlayerSkin (1), "b_c_pos_a1_pant_006,b_c_pos_a1_shrt_009");
					report.screen ("SET SUCCESSFULLY!");
					
					UICharacterSelect.RSGeneratePortrait (player$.Id);
				}
			}
			else
			{
				// keep polling
				UIWindow window$ = UIShell.FindUIWindow ("timer02", "dso_char_select");
				window$.ProcessAction (action_alphaanimation, "0.2,0,0");
			}
		}

		onescape$()
		{
			if (NetworkManager.IsConnected())
			{
				NetworkManager.Disconnect();
			}
			
			Messenger.Notify ("staging_create_character_cancel", owner);
		}
	]];

	[t:window,n:timer01]
	{
		[messages]
		{
			onshow = alphaanimation(0.01,0.0,0.0);
			onanimcomplete = call (begin$);
		}
	}

	[t:window,n:timer02]
	{
		[messages]
		{
			onshow = alphaanimation(0.05,0.0,0.0);
			onanimcomplete = call (poll$);
		}
	}

