[dso_char_create]
{
	interface = true;

	skrit = [[

		owner = UIWindow;
		
		#include "k_inc_ui"
		#include "k_inc_rs_packet"
		begin$()
		{
			UIShell.HideInterface( "dso_char_select" );
			UIShell.DeactivateInterface( "dso_char_select" );
		}

		accept$()
		{
			string name$; QueryDerivedEditBox (UIShell.FindUIWindow ("staging_char_name_edit_box_new", "dso_char_create")).GetText (name$);
			
			string selectChar$;
			UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( "selected_char", "dso_char_create" ) );
			uiText$.GetText( selectChar$);
			int currentChar$ = MakeInt(selectChar$);

			RSCreateChar$(name$, currentChar$, 1, 1, 1, 1, 1);
		}

		backtosel$()
		{
			UIShell.ActivateInterface( "ui:interfaces:multiplayer:dso_char_select", true);
		}

		btn_prev_character$()
		{
			string selectSlot$;
			UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( "selected_char", "dso_char_create" ) );
			uiText$.GetText( selectSlot$);

			int max$ = 6;
			int current$ = MakeInt(selectSlot$);
			if (current$ != 0)
			{
				current$ -= 1;
			}
			else
			{
				current$ = max$;
			}
			uiText$.SetText( MakeString(current$), true);

			} btn_next_character$() {

			string selectSlot$;
			UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( "selected_char", "dso_char_create" ) );
			uiText$.GetText( selectSlot$);

			int max$ = 6;
			int current$ = MakeInt(selectSlot$);
			if (current$ != max$)
			{
				current$ += 1;
			}
			else
			{
				current$ = 0;
			}
			uiText$.SetText( MakeString(current$), true);
		}

		btn_prev_head$()
		{
			string selectSlot$;
			UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( "selected_head", "dso_char_create" ) );
			uiText$.GetText( selectSlot$);

			int current$ = MakeInt(selectSlot$);

			} btn_next_head$() {

			string selectSlot$;
			UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( "selected_head", "dso_char_create" ) );
			uiText$.GetText( selectSlot$);

			int current$ = MakeInt(selectSlot$);

		}

		btn_prev_hair$()
		{
			string selectSlot$;
			UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( "selected_hair", "dso_char_create" ) );
			uiText$.GetText( selectSlot$);

			int current$ = MakeInt(selectSlot$);

			} btn_next_hair$() {

			string selectSlot$;
			UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( "selected_hair", "dso_char_create" ) );
			uiText$.GetText( selectSlot$);

			int current$ = MakeInt(selectSlot$);

		}

		btn_prev_face$()
		{
			string selectSlot$;
			UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( "selected_face", "dso_char_create" ) );
			uiText$.GetText( selectSlot$);

			int current$ = MakeInt(selectSlot$);

			} btn_next_face$() {

			string selectSlot$;
			UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( "selected_face", "dso_char_create" ) );
			uiText$.GetText( selectSlot$);

			int current$ = MakeInt(selectSlot$);

		}

		btn_prev_shirt$()
		{
			string selectSlot$;
			UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( "selected_shirt", "dso_char_create" ) );
			uiText$.GetText( selectSlot$);

			int current$ = MakeInt(selectSlot$);

			} btn_next_shirt$() {

			string selectSlot$;
			UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( "selected_shirt", "dso_char_create" ) );
			uiText$.GetText( selectSlot$);

			int current$ = MakeInt(selectSlot$);

		}

		btn_prev_pants$()
		{
			string selectSlot$;
			UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( "selected_pants", "dso_char_create" ) );
			uiText$.GetText( selectSlot$);

			int current$ = MakeInt(selectSlot$);

			} btn_next_pants$() {

			string selectSlot$;
			UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( "selected_pants", "dso_char_create" ) );
			uiText$.GetText( selectSlot$);

			int current$ = MakeInt(selectSlot$);

		}

		poll$()
		{
			bool transition$ = false;
			
			if (NetworkManager.IsConnected())
			{
				int received$ = NetworkManager.Receive();
				if (received$ > 0)
				{
					Packet packet$ = NetworkManager.NextPacket();
					
					int type$ = packet$.ReadUInt8();
					if (type$ == 42)
					{
						int success$ = packet$.ReadUInt8();
						if (success$ == 1)
						{
							//SetUIWindowState$ ("login_ok", "dso_char_create", true, true);
							//SetUIWindowState$ ("account_name_edit_box", "dso_char_create", true, true);
							//SetUIWindowState$ ("password_edit_box", "dso_char_create", true, true);
							
							DisplayMessage$ ("All slots already in use");
						}
						else
						{
							transition$ = true;
						}
					}
					NetworkManager.DiscardPacket (packet$);
				}
			}
			
			if (transition$ == true)
			{
				UIShell.ActivateInterface( "ui:interfaces:multiplayer:dso_char_select", true);
			}
			else
			{
				// keep polling
				UIWindow window$ = UIShell.FindUIWindow ("timer02", "dso_char_create");
				window$.ProcessAction (action_alphaanimation, "1,0,0");
			}
		}

		onescape$()
		{
			if (NetworkManager.IsConnected())
			{
				NetworkManager.Disconnect();
			}
			
			Messenger.Notify ("staging_create_character_cancel", owner);
		}
	]];

	[t:window,n:timer01]
	{
		[messages]
		{
			onshow = alphaanimation(0.01,0.0,0.0);
			onanimcomplete = call (begin$);
		}
	}

	[t:window,n:timer02]
	{
		[messages]
		{
			onshow = alphaanimation(1.0,0.0,0.0);
			onanimcomplete = call (poll$);
		}
	}

