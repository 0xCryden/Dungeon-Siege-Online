		resetSelChar$()
		{
			string selectChar$;
			UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( "selected_char", "staging_area_create_character" ) );
			uiText$.GetText( selectChar$);
			int currentChar$ = MakeInt(selectChar$);

			report.screenf ("resetSelChar");

			while ((currentChar$) > 0)
			{
				btn_prev_character$();
				Messenger.Notify ( "previous_character", UIShell.FindUIWindow( "button_prev_character", "staging_area_create_character" ));
				currentChar$ -= 1;
			}
		}
		resetSelCharSettings$()
		{
			string selectChar$;
			UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( "selected_char", "staging_area_create_character" ) );
			uiText$.GetText( selectChar$);
			int currentChar$ = MakeInt(selectChar$);

			report.screenf ("resetSelCharSettings");
			
			string headNum$;
			string faceNum$;
			string hairNum$;
			string shirtNum$;
			string pantsNum$;
			if (selectChar$ == "0") { headNum$ = "selected_head_0"; faceNum$ = "selected_face_0"; hairNum$ = "selected_hair_0"; shirtNum$ = "selected_shirt_0"; pantsNum$ = "selected_pants_0"; }
			if (selectChar$ == "1") { headNum$ = "selected_head_1"; faceNum$ = "selected_face_1"; hairNum$ = "selected_hair_1"; shirtNum$ = "selected_shirt_1"; pantsNum$ = "selected_pants_1"; }
			if (selectChar$ == "2") { headNum$ = "selected_head_2"; faceNum$ = "selected_face_2"; hairNum$ = "selected_hair_2"; shirtNum$ = "selected_shirt_2"; pantsNum$ = "selected_pants_2"; }
			if (selectChar$ == "3") { headNum$ = "selected_head_3"; faceNum$ = "selected_face_3"; hairNum$ = "selected_hair_3"; shirtNum$ = "selected_shirt_3"; pantsNum$ = "selected_pants_3"; }
			if (selectChar$ == "4") { headNum$ = "selected_head_4"; faceNum$ = "selected_face_4"; hairNum$ = "selected_hair_4"; shirtNum$ = "selected_shirt_4"; pantsNum$ = "selected_pants_4"; }
			if (selectChar$ == "5") { headNum$ = "selected_head_5"; faceNum$ = "selected_face_5"; hairNum$ = "selected_hair_5"; shirtNum$ = "selected_shirt_5"; pantsNum$ = "selected_pants_5"; }
			if (selectChar$ == "6") { headNum$ = "selected_head_6"; faceNum$ = "selected_face_6"; hairNum$ = "selected_hair_6"; shirtNum$ = "selected_shirt_6"; pantsNum$ = "selected_pants_6"; }

			string selectHead$; uiText$ = QueryDerivedText( UIShell.FindUIWindow( headNum$, "staging_area_create_character" ) ); uiText$.GetText( selectHead$);
			int currentHead$ = MakeInt(selectHead$);
			report.screenf("initial head: %d", currentHead$);
			/*if (selectChar$ == "0")
			{
				string selectHair$; uiText$ = QueryDerivedText( UIShell.FindUIWindow( hairNum$, "staging_area_create_character" ) ); uiText$.GetText( selectHair$);
				int currentHair$ = MakeInt(selectHair$);

				if (currentHead$ == 1 || currentHead$ == 2)
				{
					if (currentHair$ > 5)
					{
						currentHair$ = 0;
					}
				}
				else if (currentHead$ == 3 || currentHead$ == 4)
				{
					if (currentHair$ < 6)
					{
						currentHair$ = 6;
					}
				}

				uiText$.SetText( MakeString(currentHair$), true );
			}*/

			while (currentHead$  > 0) { btn_prev_head$(); Messenger.Notify("char_prev_head",  UIShell.FindUIWindow("button_prev_head",  "staging_area_create_character")); currentHead$ -= 1; }
			
			string selectFace$; uiText$ = QueryDerivedText( UIShell.FindUIWindow( faceNum$, "staging_area_create_character" ) ); uiText$.GetText( selectFace$);
			int currentFace$ = MakeInt(selectFace$);
			report.screenf("initial face: %d", currentFace$);
			while (currentFace$  > 0) { btn_prev_face$(); Messenger.Notify("char_prev_face",  UIShell.FindUIWindow("button_prev_face",  "staging_area_create_character")); currentFace$ -= 1; }
			
			string selectHair$; uiText$ = QueryDerivedText( UIShell.FindUIWindow( hairNum$, "staging_area_create_character" ) ); uiText$.GetText( selectHair$);
			int currentHair$ = MakeInt(selectHair$);
			report.screenf("initial hair: %d", currentHair$);
			while (currentHair$  > 0) { btn_prev_hair$(); Messenger.Notify("char_prev_hair",  UIShell.FindUIWindow("button_prev_hair",  "staging_area_create_character")); currentHair$ -= 1; }
			
			string selectShirt$; uiText$ = QueryDerivedText( UIShell.FindUIWindow( shirtNum$, "staging_area_create_character" ) ); uiText$.GetText( selectShirt$);
			int currentShirt$ = MakeInt(selectShirt$);
			report.screenf("initial shirt: %d", currentShirt$);
			while (currentShirt$ > 0) { btn_prev_shirt$(); Messenger.Notify("char_prev_shirt", UIShell.FindUIWindow("button_prev_shirt", "staging_area_create_character")); currentShirt$ -= 1; }
			
			string selectPants$; uiText$ = QueryDerivedText( UIShell.FindUIWindow( pantsNum$, "staging_area_create_character" ) ); uiText$.GetText( selectPants$);
			int currentPants$ = MakeInt(selectPants$);
			report.screenf("initial pants: %d", currentPants$);
			while (currentPants$ > 0) { btn_prev_pants$(); Messenger.Notify("char_prev_pants", UIShell.FindUIWindow("button_prev_pants", "staging_area_create_character")); currentPants$ -= 1; }
			// TODO need to also call btn_prev_head
		}

