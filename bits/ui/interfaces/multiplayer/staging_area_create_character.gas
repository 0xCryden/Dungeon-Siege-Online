[staging_area_create_character]
{
	interface = true;

	skrit = [[

		owner = UIWindow;
		
		#include "k_inc_ui"
		#include "k_inc_rs_packet"
		begin$()
		{
			UIShell.HideInterface( "dso_char_select" );
			UIShell.DeactivateInterface( "dso_char_select" );
		}

		btn_prev_character$()
		{
			string selectSlot$;
			UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( "selected_char", "staging_area_create_character" ) );
			uiText$.GetText( selectSlot$);

			int max$ = 6;
			int current$ = MakeInt(selectSlot$);
			report.screenf("current: %d", current$);
			if (current$ != 0) { current$ -= 1; } else { current$ = max$; }
			report.screenf("New current: %d", current$);
			uiText$.SetText( MakeString(current$), true);

		} btn_next_character$() {

			string selectSlot$;
			UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( "selected_char", "staging_area_create_character" ) );
			uiText$.GetText( selectSlot$);

			int max$ = 6;
			int current$ = MakeInt(selectSlot$);
			report.screenf("current: %d", current$);
			if (current$ != max$) { current$ += 1; } else { current$ = 0; }
			report.screenf("New current: %d", current$);
			uiText$.SetText( MakeString(current$), true);
		}

		btn_prev_hair$()
		{	
			report.screenf ("btn_prev_hair pressed");
			string num$; 
			int max$;
			int min$ = 0;
			string selectChar$; UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( "selected_char", "staging_area_create_character" ) ); uiText$.GetText( selectChar$);

			// heads 0- max 9
			if (selectChar$ == "0") { 
				num$ = "selected_hair_0"; 
				max$ = 9; 
				string selectHead$; UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( "selected_head_0", "staging_area_create_character" ) ); uiText$.GetText( selectHead$);
				if (selectHead$ == "1" || selectHead$ == "2")
				{
					max$ = 5;
					// if old selected num > 6  selected num = 0
				}
				else if (selectHead$ == "3" || selectHead$ == "4")
				{
					min$ = 6;
					// if old selected num is out of bounds selected hair = 6
				}
			}
			if (selectChar$ == "4") { 
				num$ = "selected_hair_4"; 
				max$ = 9; 
				string selectHead$; UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( "selected_head_4", "staging_area_create_character" ) ); uiText$.GetText( selectHead$);
				if (selectHead$ == "1" || selectHead$ == "2")
				{
					max$ = 5;
					// if old selected num > 6  selected num = 0
				}
				else if (selectHead$ == "3" || selectHead$ == "4")
				{
					min$ = 6;
					// if old selected num is out of bounds selected hair = 6
				}
			}
			if (selectChar$ == "1") { num$ = "selected_hair_1"; max$ = 9; }
			if (selectChar$ == "2") { num$ = "selected_hair_2"; max$ = 0; }
			if (selectChar$ == "3") { num$ = "selected_hair_3"; max$ = 0; }
			
			if (selectChar$ == "5") { num$ = "selected_hair_5"; max$ = 10; }
			if (selectChar$ == "6") { num$ = "selected_hair_6"; max$ = 10; }

			string selectSlot$; uiText$ = QueryDerivedText( UIShell.FindUIWindow( num$, "staging_area_create_character" ) ); uiText$.GetText( selectSlot$);

			int current$ = MakeInt(selectSlot$);
			report.screenf("current: %d", current$);

			if (current$ > min$) { current$ -= 1; } else { current$ = max$; }
			report.screenf("new current: %d", current$);
			uiText$.SetText( MakeString(current$), true);
		} btn_next_hair$() {
			report.screenf ("btn_next_hair pressed");
			string num$;
			int max$;
			int min$ = 0;
			string selectChar$; UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( "selected_char", "staging_area_create_character" ) ); uiText$.GetText( selectChar$);

			if (selectChar$ == "0") { 
				num$ = "selected_hair_0"; 
				max$ = 9; 
				string selectHead$; UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( "selected_head_0", "staging_area_create_character" ) ); uiText$.GetText( selectHead$);
				if (selectHead$ == "1" || selectHead$ == "2")
				{
					// if old selected num > 6  selected num = 0
					max$ = 5;
				}
				else if (selectHead$ == "3" || selectHead$ == "4")
				{
					// if old selected num is out of bounds selected hair = 6
					min$ = 6;
				}
			}
			if (selectChar$ == "4") { 
				num$ = "selected_hair_4"; 
				max$ = 9; 
				string selectHead$; UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( "selected_head_4", "staging_area_create_character" ) ); uiText$.GetText( selectHead$);
				if (selectHead$ == "1" || selectHead$ == "2")
				{
					// if old selected num > 6  selected num = 0
					max$ = 5;
				}
				else if (selectHead$ == "3" || selectHead$ == "4")
				{
					// if old selected num is out of bounds selected hair = 6
					min$ = 6;
				}
			}
			if (selectChar$ == "1") { num$ = "selected_hair_1"; max$ = 9; }
			if (selectChar$ == "2") { num$ = "selected_hair_2"; max$ = 0; }
			if (selectChar$ == "3") { num$ = "selected_hair_3"; max$ = 0; }
			
			if (selectChar$ == "5") { num$ = "selected_hair_5"; max$ = 10; }
			if (selectChar$ == "6") { num$ = "selected_hair_6"; max$ = 10; }
			string selectSlot$; uiText$ = QueryDerivedText( UIShell.FindUIWindow( num$, "staging_area_create_character" ) ); uiText$.GetText( selectSlot$);

			int current$ = MakeInt(selectSlot$);
			report.screenf("current: %d", current$);

			if (current$ < max$) { current$ += 1; } else { current$ = min$; }
			report.screenf("new current: %d", current$);
			uiText$.SetText( MakeString(current$), true);
		}

		btn_prev_head$()
		{	
			report.screenf ("btn_prev_head pressed");
			string num$; 
			string hairNum$;
			int max$;
			string selectChar$; UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( "selected_char", "staging_area_create_character" ) ); uiText$.GetText( selectChar$);

			if (selectChar$ == "0") { hairNum$ = "selected_hair_0"; num$ = "selected_head_0"; max$ = 4; }
			if (selectChar$ == "1") { num$ = "selected_head_1"; max$ = 4; }
			if (selectChar$ == "2") { num$ = "selected_head_2"; max$ = 0; }
			if (selectChar$ == "3") { num$ = "selected_head_3"; max$ = 0; }
			if (selectChar$ == "4") { hairNum$ = "selected_hair_4"; num$ = "selected_head_4"; max$ = 4; }
			if (selectChar$ == "5") { num$ = "selected_head_5"; max$ = 4; }
			if (selectChar$ == "6") { num$ = "selected_head_6"; max$ = 0; }

			string selectSlot$; uiText$ = QueryDerivedText( UIShell.FindUIWindow( num$, "staging_area_create_character" ) ); uiText$.GetText( selectSlot$);

			int current$ = MakeInt(selectSlot$);
			report.screenf("current: %d", current$);
			if (current$ != 0) { current$ -= 1; } else { current$ = max$; }
			report.screenf("new current: %d", current$);
			uiText$.SetText( MakeString(current$), true);
			
			// hairtohead adjustment
			if (selectChar$ == "0")
			{
				if (current$ == 0)
				{
					report.screenf ("going from head 1 to 0");
				}
				else if (current$ == 2) // if going from 3 to 2
				{
					report.screenf ("going from head 3 to 2");
					string selectHair$; UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( hairNum$, "staging_area_create_character" ) ); uiText$.GetText( selectHair$);
					int currentHair$ = MakeInt(selectHair$);

					// reset hair select to 0 internal
					
					if (currentHair$ > 5)
					{
						while (currentHair$ > 0)
						{
							btn_prev_hair$();
							currentHair$ -= 1;
							report.screenf ("new current hair: %d", currentHair$);
						}
					}
				}
				else if (current$ == 4) // if going from 0 to 4
				{
					report.screenf ("going from head 0 to 4");
					string selectHair$; UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( hairNum$, "staging_area_create_character" ) ); uiText$.GetText( selectHair$);
					int currentHair$ = MakeInt(selectHair$);

					// if selected hair < min set selected hair to min (6)
					while (currentHair$ < 6)
					{
						btn_next_hair$();
						currentHair$ += 1;
						report.screenf ("new current hair: %d", currentHair$);
					}
				}
			}

			if (selectChar$ == "4")
			{
				if (current$ == 0)
				{
					report.screenf ("going from head 1 to 0");
				}
				else if (current$ == 2) // if going from 3 to 2
				{
					report.screenf ("going from head 3 to 2");
					string selectHair$; UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( hairNum$, "staging_area_create_character" ) ); uiText$.GetText( selectHair$);
					int currentHair$ = MakeInt(selectHair$);

					// reset hair select to 0 internal
					
					if (currentHair$ > 5)
					{
						while (currentHair$ > 0)
						{
							btn_prev_hair$();
							currentHair$ -= 1;
							report.screenf ("new current hair: %d", currentHair$);
						}
					}
				}
				else if (current$ == 4) // if going from 0 to 4
				{
					report.screenf ("going from head 0 to 4");
					string selectHair$; UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( hairNum$, "staging_area_create_character" ) ); uiText$.GetText( selectHair$);
					int currentHair$ = MakeInt(selectHair$);

					// if selected hair < min set selected hair to min (6)
					while (currentHair$ < 6)
					{
						btn_next_hair$();
						currentHair$ += 1;
						report.screenf ("new current hair: %d", currentHair$);
					}
				}
			}
		} btn_next_head$() {
			report.screenf ("btn_next_head pressed");
			string num$;
			string hairNum$;
			int max$;
			string selectChar$; UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( "selected_char", "staging_area_create_character" ) ); uiText$.GetText( selectChar$);

			if (selectChar$ == "0") { hairNum$ = "selected_hair_0"; num$ = "selected_head_0"; max$ = 4; }
			if (selectChar$ == "1") { num$ = "selected_head_1"; max$ = 4; }
			if (selectChar$ == "2") { num$ = "selected_head_2"; max$ = 0; }
			if (selectChar$ == "3") { num$ = "selected_head_3"; max$ = 0; }
			if (selectChar$ == "4") { hairNum$ = "selected_hair_4"; num$ = "selected_head_4"; max$ = 4; }
			if (selectChar$ == "5") { num$ = "selected_head_5"; max$ = 4; }
			if (selectChar$ == "6") { num$ = "selected_head_6"; max$ = 0; }
			string selectSlot$; uiText$ = QueryDerivedText( UIShell.FindUIWindow( num$, "staging_area_create_character" ) ); uiText$.GetText( selectSlot$);

			int current$ = MakeInt(selectSlot$);
			report.screenf("current: %d", current$);
			if (current$ != max$) { current$ += 1; } else { current$ = 0; }
			report.screenf("new current: %d", current$);
			uiText$.SetText( MakeString(current$), true);

			// hairtohead adjustment
			if (selectChar$ == "0")
			{
				if (current$ == 0) // if going from 4 to 0
				{
					report.screenf ("going from head 4 to 0");
				}
				else if (current$ == 1) // if going from 0 to 1
				{
					report.screenf ("going from head 0 to 1");
					string selectHair$; UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( hairNum$, "staging_area_create_character" ) ); uiText$.GetText( selectHair$);
					int currentHair$ = MakeInt(selectHair$);

					// if selected hair > 5 reset hair select to 0 internal
					if (currentHair$ > 5)
					{
						while (currentHair$ > 0)
						{
							btn_prev_hair$();
							currentHair$ -= 1;
							report.screenf ("new current hair: %d", currentHair$);
						}
					}
				}
				else if (current$ == 3) // if going from 2 to 3
				{
					report.screenf ("going from head 2 to 3");
					string selectHair$; UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( hairNum$, "staging_area_create_character" ) ); uiText$.GetText( selectHair$);
					int currentHair$ = MakeInt(selectHair$);

					//report.screenf ("currentHair: %d", currentHair$);
					while (currentHair$ < 6)
					{
						btn_next_hair$();
						currentHair$ += 1;
						report.screenf ("new current hair: %d", currentHair$);
					}
					// if selected hair < min set selected hair to min
				}
			}
			if (selectChar$ == "4")
			{
				if (current$ == 0) // if going from 4 to 0
				{
					report.screenf ("going from head 4 to 0");
				}
				else if (current$ == 1) // if going from 0 to 1
				{
					report.screenf ("going from head 0 to 1");
					string selectHair$; UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( hairNum$, "staging_area_create_character" ) ); uiText$.GetText( selectHair$);
					int currentHair$ = MakeInt(selectHair$);

					// if selected hair > 5 reset hair select to 0 internal
					
					if (currentHair$ > 5)
					{
						while (currentHair$ > 0)
						{
							btn_prev_hair$();
							currentHair$ -= 1;
							report.screenf ("new current hair: %d", currentHair$);
						}
					}
				}
				else if (current$ == 3) // if going from 2 to 3
				{
					report.screenf ("going from head 2 to 3");
					string selectHair$; UIText uiText$ = QueryDerivedText( UIShell.FindUIWindow( hairNum$, "staging_area_create_character" ) ); uiText$.GetText( selectHair$);
					int currentHair$ = MakeInt(selectHair$);

					//report.screenf ("currentHair: %d", currentHair$);
					while (currentHair$ < 6)
					{
						btn_next_hair$();
						currentHair$ += 1;
						report.screenf ("new current hair: %d", currentHair$);
					}
					// if selected hair < min set selected hair to min
				}
			}
		}

