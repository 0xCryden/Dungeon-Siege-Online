void RCUpdateGo$ (Packet packet$)
{
	int id$ = packet$.ReadUInt32();
	float maxHp$ = packet$.ReadFloat();
	float hp$ = packet$.ReadFloat();
	float maxMana$ = packet$.ReadFloat();
	float mana$ = packet$.ReadFloat();
	int ls$ = packet$.ReadUInt8();

	Go temp$ = Server.ScreenHero;

	string tmp$;
	StringTool.AssignF (tmp$, "godb:%d", id$);
	Goid actor$ = MakeGoid (GameAuditor.GetDb.GetInt (tmp$));

	int portalId$ = temp$.GetComponentInt ("portal", "id");

	//report.screenf ("actor: %d", actor$);
	//report.screenf ("portalId: %d", portalId$);

	bool isPortal$ = false;
	if (actor$ == portalId$)
	{
		isPortal$ = true;
		actor$ = temp$.Goid;
		report.screenf ("actor is portal, updating oneself");
	}

	if (!actor$.IsValid())
		{ return; }
		

	//if (actor$.Go.Aspect.CurrentLife != hp$)
	{
		actor$.Go.Aspect.RCSetMaxLife(maxHp$);
		actor$.Go.Aspect.RCSetCurrentLife(hp$);

		actor$.Go.Aspect.RCSetMaxMana(maxMana$);
		actor$.Go.Aspect.RCSetCurrentMana(mana$);

		if (actor$.Go.Aspect.CurrentLife != hp$)
		{
			float diff$ = hp$ - actor$.Go.Aspect.CurrentLife;
			Rules.ChangeLife(actor$, diff$);
		}
		if (actor$.Go.Aspect.CurrentMana != mana$)
		{
			float diff$ = mana$ - actor$.Go.Aspect.CurrentMana;
			Rules.ChangeMana(actor$, diff$);
		}
	}

	// if was alive and new ls unconscious
	if (isPortal$ == false)
	{
		if (actor$.Go.Aspect.LifeState != MakeLifeState(ls$))
		{
			report.screenf ("updatego changing lifestate from %d to %d", actor$.Go.Aspect.LifeState, ls$);
			report.screenf ("isPortal false");
			actor$.Go.Aspect.RCSetLifeState(MakeLifeState(ls$));
			if (MakeLifeState(ls$) == ls_alive_conscious)
			{
				report.screenf ("MakeLifeState %d, %d", actor$.Go.Aspect.LifeState, ls$);
				// revive the character
				actor$.Go.Mind.SetMayAttack (true);
				actor$.Go.Mind.SetMayBeAttacked (true);
					
				PostWorldMessage (WE_GAINED_CONSCIOUSNESS, actor$, actor$, 0);
			}
			else if (MakeLifeState(ls$) == ls_alive_unconscious)
			{
				actor$.Go.Mind.SetMayAttack (false);
				actor$.Go.Mind.SetMayBeAttacked (true);
					
				PostWorldMessage (WE_LOST_CONSCIOUSNESS, actor$, actor$, 0);
				actor$.Go.PlayVoiceSound ("die", 5, 80, false);
			}
			else if (MakeLifeState(ls$) == ls_dead_normal)
			{
				actor$.Go.Mind.SetMayAttack (false);
				actor$.Go.Mind.SetMayBeAttacked (false);
					
				PostWorldMessage (WE_LOST_CONSCIOUSNESS, actor$, actor$, 0);
				actor$.Go.PlayVoiceSound ("die", 5, 80, false);
			}
			else if (MakeLifeState(ls$) == ls_dead_charred)
			{
			}
			else if (MakeLifeState(ls$) == ls_decay_fresh)
			{
			}
			else if (MakeLifeState(ls$) == ls_decay_bones)
			{
			}
			else if (MakeLifeState(ls$) == ls_decay_dust)
			{
			}
			else if (MakeLifeState(ls$) == ls_ghost)
			{
			}
		}
	}
	else
	{
		if (actor$.Go.Aspect.LifeState != MakeLifeState(ls$))
		{
			report.screenf ("updatego changing lifestate from %d to %d", actor$.Go.Aspect.LifeState, ls$);
			actor$.Go.Aspect.RCSetLifeState(MakeLifeState(ls$));

			if (MakeLifeState(ls$) == ls_alive_conscious)
			{
				// revive the character
				actor$.Go.Mind.SetMayAttack (true);
				actor$.Go.Mind.SetMayBeAttacked (true);
					
				PostWorldMessage (WE_GAINED_CONSCIOUSNESS, actor$, actor$, 0);
			}
			else if (MakeLifeState(ls$) == ls_alive_unconscious)
			{
				actor$.Go.Mind.SetMayAttack (false);
				actor$.Go.Mind.SetMayBeAttacked (true);
					
				PostWorldMessage (WE_LOST_CONSCIOUSNESS, actor$, actor$, 0);
				actor$.Go.PlayVoiceSound ("die", 5, 80, false);
			}
			else if (MakeLifeState(ls$) == ls_dead_normal)
			{
				actor$.Go.Mind.SetMayAttack (false);
				actor$.Go.Mind.SetMayBeAttacked (false);
					
				PostWorldMessage (WE_LOST_CONSCIOUSNESS, actor$, actor$, 0);
				actor$.Go.PlayVoiceSound ("die", 5, 80, false);
			}
			else if (MakeLifeState(ls$) == ls_dead_charred)
			{
			}
			else if (MakeLifeState(ls$) == ls_decay_fresh)
			{
			}
			else if (MakeLifeState(ls$) == ls_decay_bones)
			{
			}
			else if (MakeLifeState(ls$) == ls_decay_dust)
			{
			}
			else if (MakeLifeState(ls$) == ls_ghost)
			{
			}
		}
		string tmp$;
		StringTool.AssignF (tmp$, "godb:%d", id$);
		Goid actor$ = MakeGoid (GameAuditor.GetDb.GetInt (tmp$));
		if (actor$.Go.Aspect.LifeState != MakeLifeState(ls$))
		{
			report.screenf ("updatego changing lifestate from %d to %d", actor$.Go.Aspect.LifeState, ls$);
			actor$.Go.Aspect.RCSetLifeState(MakeLifeState(ls$));

			if (MakeLifeState(ls$) == ls_alive_conscious)
			{
				// revive the character
				actor$.Go.Mind.SetMayAttack (true);
				actor$.Go.Mind.SetMayBeAttacked (true);
					
				PostWorldMessage (WE_GAINED_CONSCIOUSNESS, actor$, actor$, 0);
			}
			else if (MakeLifeState(ls$) == ls_alive_unconscious)
			{
				actor$.Go.Mind.SetMayAttack (false);
				actor$.Go.Mind.SetMayBeAttacked (true);
					
				PostWorldMessage (WE_LOST_CONSCIOUSNESS, actor$, actor$, 0);
				actor$.Go.PlayVoiceSound ("die", 5, 80, false);
			}
			else if (MakeLifeState(ls$) == ls_dead_normal)
			{
				actor$.Go.Mind.SetMayAttack (false);
				actor$.Go.Mind.SetMayBeAttacked (false);
					
				PostWorldMessage (WE_LOST_CONSCIOUSNESS, actor$, actor$, 0);
				actor$.Go.PlayVoiceSound ("die", 5, 80, false);
			}
			else if (MakeLifeState(ls$) == ls_dead_charred)
			{
			}
			else if (MakeLifeState(ls$) == ls_decay_fresh)
			{
			}
			else if (MakeLifeState(ls$) == ls_decay_bones)
			{
			}
			else if (MakeLifeState(ls$) == ls_decay_dust)
			{
			}
			else if (MakeLifeState(ls$) == ls_ghost)
			{
			}
		}
	}
}

void RCAddExp$ (Packet packet$)
{
	int id$ = packet$.ReadUInt32();
	float experience$ = packet$.ReadFloat();
	
	Go temp$ = Server.ScreenHero;
	
	string tmp$; StringTool.AssignF (tmp$, "godb:%d", id$);
	Goid actor$ = MakeGoid (GameAuditor.GetDb.GetInt (tmp$));
	
	int portalId$ = temp$.GetComponentInt ("portal", "id");
	if (actor$ != portalId$)
	{
		temp$ = actor$.Go;
	}

	Go Weapon$ = NULL;
	if( temp$.Inventory.IsMeleeWeaponSelected || temp$.Inventory.IsRangedWeaponSelected )
	{
		Weapon$ = temp$.Inventory.GetSelectedWeapon;
	} else if ( temp$.Inventory.IsSpellSelected ) {
		Weapon$ = temp$.Inventory.GetSelectedSpell;
	}
	
	if (Weapon$ != NULL ) 
	{
		Rules.AwardExperience( temp$.goid, Weapon$.goid, experience$ );
	} 
	else
	{
		Rules.AwardExperience( temp$.goid, temp$.goid, experience$ );
	}
}

