void RSInvenMove$ (int id$, int containerId$, int destLoc$)
{
	//report.screenf("[DEBUG INVENMOVE]  id: %d | containerId: %d | destLoc: %d\n", id$, containerId$, destLoc$ );
            	
	Packet packet$ = NetworkManager.CreatePacket();
	
	packet$.WriteUInt8 (31);
	packet$.WriteUInt32 (id$);
	packet$.WriteUInt32 (containerId$);
	packet$.WriteUInt8 (destLoc$);
	
	NetworkManager.Send (packet$);
	NetworkManager.DiscardPacket (packet$);
}

void RSReqNodeInfo$ (int id$, float x$, float y$, float z$, int rotation$)
{
	report.screenf("[DEBUG NODEADD]  id: %d | Coords %f/%f/%f | Rotation: %d\n", id$, x$, y$, z$, rotation$ );
            	
	Packet packet$ = NetworkManager.CreatePacket();
	
	packet$.WriteUInt8 (32);
	packet$.WriteUInt32 (id$);
	packet$.WriteFloat (x$);
	packet$.WriteFloat (y$);
	packet$.WriteFloat (z$);
	packet$.WriteUInt8 (rotation$);

	NetworkManager.Send (packet$);
	NetworkManager.DiscardPacket (packet$);
}

void RSSelectSlot$ (int slotId$)
{
	Go temp$ = Server.ScreenHero;
	int portalId$ = temp$.GetComponentInt ("portal", "id");

	string tmp$;
	StringTool.AssignF (tmp$, "godb:%d", portalId$);
	Goid actor$ = Server.ScreenHero.Goid;//MakeGoid (GameAuditor.GetDb.GetInt (tmp$));

	if (slotId$ == 3 || slotId$ == 4)
	{
		//report.screenf ("slot is 3 or 4");
		if (actor$.Go.Inventory.IsSlotEquipped(es_weapon_hand))
		{
			//report.screenf ("es_weapon_hand found");
			if (actor$.Go.Inventory.GetEquipped(es_weapon_hand).Attack.AttackClass != ac_staff)
			{
				//report.screenf ("AttackClass not staff");
				actor$.Go.Inventory.RSUnequip (es_weapon_hand, ao_human);
				RSUnequip$ (MakeInt(es_weapon_hand));
			}
		}

		if (actor$.Go.Inventory.IsSlotEquipped(es_shield_hand))
		{
			//report.screenf ("es_shield_hand found");
			actor$.Go.Inventory.RSUnequip (es_shield_hand, ao_human);
			RSUnequip$ (MakeInt(es_shield_hand));
		}
	}

	Packet packet$ = NetworkManager.CreatePacket();
	
	packet$.WriteUInt8 (36);
	packet$.WriteUInt8 (slotId$);
	
	NetworkManager.Send (packet$);
	NetworkManager.DiscardPacket (packet$);
}

