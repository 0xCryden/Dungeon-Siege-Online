void RSCreateChar$ (string charName$, int charType$, int charHead$, int charSkin$, int charHair$, int charShirt$, int charPants$)
{
	Packet packet$ = NetworkManager.CreatePacket();
	
	packet$.WriteUInt8 (42);
	packet$.WriteString (charName$);
	packet$.WriteUInt8 (charType$);
	packet$.WriteUInt8 (charHead$);
	packet$.WriteUInt8 (charSkin$);
	packet$.WriteUInt8 (charHair$);
	packet$.WriteUInt8 (charShirt$);
	packet$.WriteUInt8 (charPants$);
	
	NetworkManager.Send (packet$);
	NetworkManager.DiscardPacket (packet$);
}