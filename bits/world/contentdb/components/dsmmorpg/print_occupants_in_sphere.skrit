					int rotation$ = 1;
					if (hasLastPos$)
					{
						Vector relVec$ = GetZeroVector();
						GetSiegeDifference(relVec$, lastSiegePos$, siegePosB$);

						float dx$ = relVec$.X;
						float dz$ = relVec$.Z;

						// Determine cardinal direction based on dominant axis
						if (Math.Abs(dx$) > Math.Abs(dz$))
						{
							if (dx$ > 0)
								{ rotation$ = 2; } // East
							else
								{ rotation$ = 4; } // West
						}
						else
						{
							if (dz$ > 0)
								{ rotation$ = 3; } // South
							else
								{ rotation$ = 1; } // North
						}
					}


					Vector absVec$ = GetZeroVector();

					if (!hasLastPos$)
					{
						// First node, just use its local position directly (or define as zero)
						absVec$ = GetZeroVector();
					}
					else
					{
						Vector relVec$ = GetZeroVector();
						GetSiegeDifference(relVec$, lastSiegePos$, siegePosB$);

						// Rotate relVec$ by previous rotation
						if (lastRotation$ == 1)       // North
						{
							absVec$.X = lastAbsPos$.X + relVec$.Z;
							absVec$.Y = lastAbsPos$.Y + relVec$.Y;
							absVec$.Z = lastAbsPos$.Z + relVec$.X;
						}
						else if (lastRotation$ == 2)  // East
						{
							absVec$.X = lastAbsPos$.X + relVec$.Z;
							absVec$.Y = lastAbsPos$.Y + relVec$.Y;
							absVec$.Z = lastAbsPos$.Z - relVec$.X;
						}
						else if (lastRotation$ == 3)  // South
						{
							absVec$.X = lastAbsPos$.X - relVec$.X;
							absVec$.Y = lastAbsPos$.Y + relVec$.Y;
							absVec$.Z = lastAbsPos$.Z - relVec$.Z;
						}
						else if (lastRotation$ == 4)  // West
						{
							absVec$.X = lastAbsPos$.X - relVec$.Z;
							absVec$.Y = lastAbsPos$.Y + relVec$.Y;
							absVec$.Z = lastAbsPos$.Z + relVec$.X;
						}
					}

					// Save current as "last"
					lastAbsPos$.X = absVec$.X;
					lastAbsPos$.Y = absVec$.Y;
					lastAbsPos$.Z = absVec$.Z;

					lastSiegePos$ = SiegePos.Copy(siegePosB$);
					lastRotation$ = rotation$;
					hasLastPos$ = true;
					lastObject$ = object$;

					float rx$ = Math.Round(absVec$.X);
					float ry$ = Math.Round(absVec$.Y);
					float rz$ = Math.Round(absVec$.Z);

					// Add to list to prevent double-processing
					spawnedNodes$ = ListPushInt$(spawnedNodes$, guid$);
					Log("\t<node id=\"%u\" x=\"%f\" y=\"%f\" z=\"%f\" rotation=\"%i\" />", guid$, rx$, rz$, ry$, rotation$);
				
				}
			}
		}
		this.CreateTimer( 2, 5.0 );
	}

