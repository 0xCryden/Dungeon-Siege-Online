owner = GoSkritComponent;

property	int			id$;

			Goid		watching$;

#include "k_inc_rs_packet"

startup state startup$
{
	event OnGoHandleMessage$ (eWorldEvent event$, WorldMessage message$)
	{
		if (event$ == we_entered_world)
		{
			UIShell.HideInterface( "dso_char_select" );
			UIShell.DeactivateInterface( "dso_char_select" );

			UIShell.HideInterface( "dso_server_select" );
			UIShell.DeactivateInterface( "dso_server_select" );

			owner.Go.Common.SSetScreenName ("");
			owner.Go.Aspect.SetRenderScale (0.001);
			// set new model & stuff 
			owner.Go.Actor.RCUpdatePortraitTexture();
			
			owner.Go.Aspect.AspectHandle.SetHideMeshFlag( true );

			GoCloneReq req$ = MakeGoCloneReq ("NetworkManager");
			req$.Omni = true;
			Goid network$ = GoDb.SCloneGo (req$);
			
			GameAuditor.GetDb.SetInt ("client:network:manager", MakeInt (network$));
			
			RSPlayerReady$();

			// set min max settings
			SiegeEngine.Camera.MinAzimuth = -5;
			SiegeEngine.Camera.MaxAzimuth = 90;
			SiegeEngine.Camera.MinDistance = 0;
			SiegeEngine.Camera.MaxDistance = 30;
			SiegeEngine.Camera.SetFieldOfViewDeg(90.0);
			
			// set time of day
			TimeOfDay.RCSetTime(GetCurrentHour(), GetCurrentMinute());
		}
	}
	
	event OnGoHandleCcMessage$ (eWorldEvent event$, WorldMessage message$)
	{
		if (event$ == we_mind_processing_new_job)
		{
			watching$ = MakeGoid (id$);
			if (watching$.IsValid())
			{
				eJobAbstractType jat$ = watching$.Go.Mind.FrontActionJat;
				if (jat$ == jat_move)
				{
					SetState (moving$);
				}
			}
		}
	}
}

state moving$
{
	event OnEnterState$
	{
		this.CreateTimer (1, 1.2);
	}
	
	trigger OnTimer$ (1)
	{
		this.CreateTimer (1, 1.2);
		
		RSJobTravelDistanceReached$ (watching$.Go.Placement.Position);
	}
	
	event OnGoHandleCcMessage$ (eWorldEvent event$, WorldMessage message$)
	{
		if (event$ == we_mind_processing_new_job)
		{
			eJobAbstractType jat$ = watching$.Go.Mind.FrontActionJat;
			if (jat$ != jat_move)
			{
				RSJobTravelDistanceReached$ (watching$.Go.Placement.Position);
				
				SetState (idle$);
			}
		}
	}
}

state idle$
{
	event OnGoHandleCcMessage$ (eWorldEvent event$, WorldMessage message$)
	{
		if (event$ == we_mind_processing_new_job)
		{
			eJobAbstractType jat$ = watching$.Go.Mind.FrontActionJat;
			
			if (jat$ == jat_move)
			{
				SetState (moving$);
			}
		}
	}
}