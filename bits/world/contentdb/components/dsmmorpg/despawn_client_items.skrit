owner = GoSkritComponent;

#include "k_inc_rs_packet"

			Go			go$;


startup state startup$
{
	event OnGoHandleMessage$ (eWorldEvent event$, WorldMessage message$)
	{
		if (event$ == we_entered_world)
		{
			go$ = owner.Go;

			if (go$.IsItem())
			{
				//report.screenf ("go with despawn_client_items is item");
				if (go$.HasComponent("object"))
				{
					//report.screenf ("go with despawn_client_items HasComponent Object");
					if (go$.GetComponentInt ("object", "id") == 0)
					{
						report.screenf ("go with despawn_client_items deleting  ...");
						PostWorldMessage (we_req_delete, go$.Goid, go$.Goid, 0.0);
					}
				}
				/*else
				{
					report.screenf ("go with despawn_client_items deleting  ...");
					PostWorldMessage (we_req_delete, go$.Goid, go$.Goid, 0.0);
				}*/
			}
		}
	}
}